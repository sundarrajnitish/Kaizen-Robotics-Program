   1:TTR.c         **** /*
   2:TTR.c         ****  * Project : Table Top Robot (edge avoider)
   3:TTR.c         ****  * Level   : Kaizen Robotics Program - Level 1
   4:TTR.c         ****  * Board   : ATmega16 @ 1 MHz, Embedded C (WinAVR, register level)
   5:TTR.c         ****  *
   6:TTR.c         ****  * Roams on a table top without falling off. Four downward-facing IR
   7:TTR.c         ****  * sensors read 0 while they see the table and 1 once they pass the edge.
   8:TTR.c         ****  * Depending on which sensors left the table, the robot reverses or moves
   9:TTR.c         ****  * forward briefly and then turns back towards the table.
  10:TTR.c         ****  *
  11:TTR.c         ****  * Wiring:
  12:TTR.c         ****  *   PD3        <- sensor 1   (internal pull-up enabled)
  13:TTR.c         ****  *   PD2        <- sensor 2   (internal pull-up enabled)
  14:TTR.c         ****  *   PD1        <- sensor 3   (internal pull-up enabled)
  15:TTR.c         ****  *   PD0        <- sensor 4   (internal pull-up enabled)
  16:TTR.c         ****  *   PB0..PB3   -> L293D motor driver inputs
  17:TTR.c         ****  */
  18:TTR.c         **** 
  19:TTR.c         **** #include <avr/io.h>
  20:TTR.c         **** #include <util/delay.h>
  21:TTR.c         **** 
  22:TTR.c         **** #define MOTOR_FORWARD   0b00001010
  23:TTR.c         **** #define MOTOR_BACKWARD  0b00000101
  24:TTR.c         **** #define MOTOR_LEFT      0b00000110  // Spin left on the spot
  25:TTR.c         **** #define MOTOR_RIGHT     0b00001001  // Spin right on the spot
  26:TTR.c         **** 
  27:TTR.c         **** // PIND patterns: a 1 bit means that sensor is over the table edge
  28:TTR.c         **** #define ON_TABLE        0b11110000
  29:TTR.c         **** #define OFF_S1          0b11111000
  30:TTR.c         **** #define OFF_S2          0b11110100
  31:TTR.c         **** #define OFF_S3          0b11110010
  32:TTR.c         **** #define OFF_S4          0b11110001
  33:TTR.c         **** #define OFF_S1_S2       0b11111100
  34:TTR.c         **** #define OFF_S1_S4       0b11111001
  35:TTR.c         **** #define OFF_S3_S4       0b11110011
  36:TTR.c         **** #define OFF_S2_S3       0b11110110
  37:TTR.c         **** #define OFF_S1_S2_S3    0b11111110
  38:TTR.c         **** #define ONLY_S1_ON      0b11110111
  39:TTR.c         **** #define ONLY_S2_ON      0b11111011
  40:TTR.c         **** #define ONLY_S3_ON      0b11111101
  41:TTR.c         **** 

   1:SpeedCntrl.c  **** /*
   2:SpeedCntrl.c  ****  * Project : ADC Based Speed Control
   3:SpeedCntrl.c  ****  * Level   : Kaizen Robotics Program - Level 1
   4:SpeedCntrl.c  ****  * Board   : ATmega16 @ 1 MHz, Embedded C (WinAVR, register level)
   5:SpeedCntrl.c  ****  *
   6:SpeedCntrl.c  ****  * Reads a potentiometer on ADC0 and uses the reading to set the duty
   7:SpeedCntrl.c  ****  * cycle of a software PWM signal that drives both motors forward.
   8:SpeedCntrl.c  ****  * Turning the potentiometer up lengthens the OFF time, slowing the robot;
   9:SpeedCntrl.c  ****  * past ADC_STOP_THRESHOLD the motors stop completely.
  10:SpeedCntrl.c  ****  *
  11:SpeedCntrl.c  ****  *   PWM period  = 25 ms
  12:SpeedCntrl.c  ****  *   OFF time    = ADC reading / 40   (0 .. 25 ms)
  13:SpeedCntrl.c  ****  *   ON time     = period - OFF time
  14:SpeedCntrl.c  ****  *
  15:SpeedCntrl.c  ****  * Wiring:
  16:SpeedCntrl.c  ****  *   PA0 (ADC0) <- potentiometer wiper (pot across AVCC and GND)
  17:SpeedCntrl.c  ****  *   PB0..PB3   -> L293D motor driver inputs
  18:SpeedCntrl.c  ****  */
  19:SpeedCntrl.c  **** 
  20:SpeedCntrl.c  **** #include <avr/io.h>
  21:SpeedCntrl.c  **** #include <util/delay.h>
  22:SpeedCntrl.c  **** 
  23:SpeedCntrl.c  **** #define MOTOR_STOP          0b00000000
  24:SpeedCntrl.c  **** #define MOTOR_FORWARD       0b00001010
  25:SpeedCntrl.c  **** 
  26:SpeedCntrl.c  **** #define PWM_PERIOD_MS       25      // Total period of one PWM cycle
  27:SpeedCntrl.c  **** #define ADC_SCALE           40      // ADC counts per millisecond of OFF time
  28:SpeedCntrl.c  **** #define ADC_STOP_THRESHOLD  870     // Readings at or above this stop the motors
  29:SpeedCntrl.c  **** 
  30:SpeedCntrl.c  **** // _delay_ms() needs a compile-time constant, so wait 1 ms at a time
  31:SpeedCntrl.c  **** static void delay_ms(uint16_t ms)
  32:SpeedCntrl.c  **** {
  33:SpeedCntrl.c  ****     while (ms--)
  34:SpeedCntrl.c  ****     {
  35:SpeedCntrl.c  ****         _delay_ms(1);
  36:SpeedCntrl.c  ****     }
  37:SpeedCntrl.c  **** }
  38:SpeedCntrl.c  **** 
  39:SpeedCntrl.c  **** static void init_adc(void)
  40:SpeedCntrl.c  **** {
  41:SpeedCntrl.c  ****     ADCSRA |= (1 << ADEN);          // Enable the ADC
  42:SpeedCntrl.c  ****     ADCSRA |= (1 << ADPS2);         // Prescaler /16 -> 62.5 kHz ADC clock
  43:SpeedCntrl.c  ****     ADMUX  |= (1 << REFS0);         // AVCC as reference, channel ADC0
  44:SpeedCntrl.c  **** }
  45:SpeedCntrl.c  **** 
  46:SpeedCntrl.c  **** static uint16_t read_adc(void)
  47:SpeedCntrl.c  **** {
  48:SpeedCntrl.c  ****     ADCSRA |= (1 << ADSC);          // Start a conversion
  49:SpeedCntrl.c  ****     while ((ADCSRA & (1 << ADIF)) == 0)
  50:SpeedCntrl.c  ****     {
  51:SpeedCntrl.c  ****         // Wait for the conversion to finish
  52:SpeedCntrl.c  ****     }
  53:SpeedCntrl.c  ****     ADCSRA |= (1 << ADIF);          // Clear the flag by writing 1 to it
  54:SpeedCntrl.c  **** 
  55:SpeedCntrl.c  ****     return ADC;                     // 10-bit result, 0..1023
  56:SpeedCntrl.c  **** }
  57:SpeedCntrl.c  **** 

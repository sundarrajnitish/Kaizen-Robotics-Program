   1:OARLFR.c      **** /*
   2:OARLFR.c      ****  * Project : Obstacle Avoiding Line Follower (OAR + LFR)
   3:OARLFR.c      ****  * Level   : Kaizen Robotics Program - Level 1
   4:OARLFR.c      ****  * Board   : ATmega16 @ 1 MHz, Embedded C (WinAVR, register level)
   5:OARLFR.c      ****  *
   6:OARLFR.c      ****  * Line follower with a front proximity sensor. It follows the black line
   7:OARLFR.c      ****  * with two IR sensors, beeps while crossing junctions, and stops whenever
   8:OARLFR.c      ****  * something blocks the path. It drives on once the obstacle is removed.
   9:OARLFR.c      ****  *
  10:OARLFR.c      ****  *   Line sensors     : 0 over white, 1 over the black line
  11:OARLFR.c      ****  *   Obstacle sensor  : 0 when an obstacle is in front, 1 when clear
  12:OARLFR.c      ****  *
  13:OARLFR.c      ****  * Wiring:
  14:OARLFR.c      ****  *   PD0        <- left line sensor   (internal pull-up enabled)
  15:OARLFR.c      ****  *   PD1        <- obstacle sensor    (internal pull-up enabled)
  16:OARLFR.c      ****  *   PD2        <- right line sensor  (internal pull-up enabled)
  17:OARLFR.c      ****  *   PB0..PB3   -> L293D motor driver inputs
  18:OARLFR.c      ****  *   PB4        -> buzzer
  19:OARLFR.c      ****  */
  20:OARLFR.c      **** 
  21:OARLFR.c      **** #include <avr/io.h>
  22:OARLFR.c      **** 
  23:OARLFR.c      **** #define MOTOR_STOP      0b00000000
  24:OARLFR.c      **** #define MOTOR_FORWARD   0b00001010
  25:OARLFR.c      **** #define MOTOR_LEFT      0b00000110  // Spin left on the spot
  26:OARLFR.c      **** #define MOTOR_RIGHT     0b00001001  // Spin right on the spot
  27:OARLFR.c      **** #define BUZZER          0b00010000
  28:OARLFR.c      **** 
  29:OARLFR.c      **** // PIND patterns (bit 0 = left line, bit 1 = obstacle, bit 2 = right line)
  30:OARLFR.c      **** #define LINE_CENTRED            0b11111010
  31:OARLFR.c      **** #define LINE_UNDER_LEFT         0b11111011
  32:OARLFR.c      **** #define LINE_UNDER_RIGHT        0b11111110
  33:OARLFR.c      **** #define JUNCTION                0b11111111
  34:OARLFR.c      **** #define BLOCKED_CENTRED         0b11111000
  35:OARLFR.c      **** #define BLOCKED_UNDER_LEFT      0b11111001
  36:OARLFR.c      **** #define BLOCKED_UNDER_RIGHT     0b11111100
  37:OARLFR.c      **** #define BLOCKED_JUNCTION        0b11111101
  38:OARLFR.c      **** 
  39:OARLFR.c      **** int main(void)
  40:OARLFR.c      **** {
  16               		.loc 1 40 1 view -0

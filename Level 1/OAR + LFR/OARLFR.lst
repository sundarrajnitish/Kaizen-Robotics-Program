  24 0000 11BA      		out 0x11,__zero_reg__
  42:OARLFR.c      ****     PORTD = 0b11111111;             // Enable pull-ups on Port D
  25               		.loc 1 42 5 is_stmt 1 view .LVU3
  26               		.loc 1 42 11 is_stmt 0 view .LVU4
  27 0002 8FEF      		ldi r24,lo8(-1)

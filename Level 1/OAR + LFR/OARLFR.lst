  43:OARLFR.c      ****     DDRB  = 0b11111111;             // Port B is an output port
  29               		.loc 1 43 5 is_stmt 1 view .LVU5
  30               		.loc 1 43 11 is_stmt 0 view .LVU6
  31 0006 87BB      		out 0x17,r24
  44:OARLFR.c      **** 
  45:OARLFR.c      ****     while (1)
  46:OARLFR.c      ****     {
  47:OARLFR.c      ****         switch (PIND)
  48:OARLFR.c      ****         {
  49:OARLFR.c      ****             case LINE_CENTRED:
  50:OARLFR.c      ****                 PORTB = MOTOR_FORWARD;
  51:OARLFR.c      ****                 break;
  52:OARLFR.c      **** 
  53:OARLFR.c      ****             case LINE_UNDER_LEFT:
  54:OARLFR.c      ****                 PORTB = MOTOR_LEFT;
  55:OARLFR.c      ****                 break;
  56:OARLFR.c      **** 
  57:OARLFR.c      ****             case LINE_UNDER_RIGHT:
  58:OARLFR.c      ****                 PORTB = MOTOR_RIGHT;
  59:OARLFR.c      ****                 break;
  60:OARLFR.c      **** 
  61:OARLFR.c      ****             case JUNCTION:
  62:OARLFR.c      ****                 PORTB = MOTOR_FORWARD | BUZZER;     // Beep and cross over

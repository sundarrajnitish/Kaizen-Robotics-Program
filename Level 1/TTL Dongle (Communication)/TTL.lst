   1:TTL.c         **** /*
   2:TTL.c         ****  * Project : Serial Communication via TTL Dongle
   3:TTL.c         ****  * Level   : Kaizen Robotics Program - Level 1
   4:TTL.c         ****  * Board   : ATmega16 @ 1 MHz, Embedded C (WinAVR, register level)
   5:TTL.c         ****  *
   6:TTL.c         ****  * Drives the robot from a PC terminal (or Bluetooth module) over UART.
   7:TTL.c         ****  * Each received character selects a motion; any other character stops.
   8:TTL.c         ****  *
   9:TTL.c         ****  *   'F' forward   'B' backward   'L' left   'R' right
  10:TTL.c         ****  *
  11:TTL.c         ****  * Wiring:
  12:TTL.c         ****  *   PD0 (RXD)  <- TX of the USB-TTL dongle / HC-05, 4800 baud 8N1
  13:TTL.c         ****  *   PB0..PB3   -> L293D motor driver inputs
  14:TTL.c         ****  */
  15:TTL.c         **** 
  16:TTL.c         **** #ifndef F_CPU
  17:TTL.c         **** #define F_CPU 1000000UL
  18:TTL.c         **** #endif
  19:TTL.c         **** 
  20:TTL.c         **** #include <avr/io.h>
  21:TTL.c         **** #include <util/delay.h>
  22:TTL.c         **** 
  23:TTL.c         **** #define BAUDRATE        4800
  24:TTL.c         **** #define UBRR_VALUE      ((F_CPU / (BAUDRATE * 16UL)) - 1)
  25:TTL.c         **** 
  26:TTL.c         **** #define MOTOR_STOP      0b00000000
  27:TTL.c         **** #define MOTOR_FORWARD   0b00001010
  28:TTL.c         **** #define MOTOR_BACKWARD  0b00000101
  29:TTL.c         **** #define MOTOR_LEFT      0b00000110  // Spin left on the spot
  30:TTL.c         **** #define MOTOR_RIGHT     0b00001001  // Spin right on the spot
  31:TTL.c         **** 
  32:TTL.c         **** static void uart_init(void)
  33:TTL.c         **** {
  34:TTL.c         ****     UBRRH = (uint8_t)(UBRR_VALUE >> 8);
  35:TTL.c         ****     UBRRL = (uint8_t)UBRR_VALUE;
  36:TTL.c         ****     UCSRB |= (1 << RXEN);           // Enable the receiver
  37:TTL.c         **** }
  38:TTL.c         **** 
  39:TTL.c         **** static uint8_t uart_receive(void)
  40:TTL.c         **** {
  41:TTL.c         ****     while ((UCSRA & (1 << RXC)) == 0)
  42:TTL.c         ****     {
  43:TTL.c         ****         // Wait until a byte has been received
  44:TTL.c         ****     }
  45:TTL.c         ****     return UDR;
  46:TTL.c         **** }
  47:TTL.c         **** 
  48:TTL.c         **** int main(void)

   1:PWM.c         **** /*
   2:PWM.c         ****  * Project : Pulse Width Modulation (software PWM)
   3:PWM.c         ****  * Level   : Kaizen Robotics Program - Level 1
   4:PWM.c         ****  * Board   : ATmega16 @ 1 MHz, Embedded C (WinAVR, register level)
   5:PWM.c         ****  *
   6:PWM.c         ****  * Toggles PA0 with two different on/off timings so the effect of the
   7:PWM.c         ****  * pulse width can be seen on an LED or motor connected to PA0:
   8:PWM.c         ****  *   - a fast 50 ms / 50 ms pulse (LED appears to flicker quickly)
   9:PWM.c         ****  *   - a slow 1 s / 1 s pulse     (LED visibly blinks)
  10:PWM.c         ****  *
  11:PWM.c         ****  * Wiring:
  12:PWM.c         ****  *   PA0 -> LED (through resistor) or motor driver input
  13:PWM.c         ****  */
  14:PWM.c         **** 
  15:PWM.c         **** #include <avr/io.h>
  16:PWM.c         **** #include <util/delay.h>
  17:PWM.c         **** 
  18:PWM.c         **** #define OUTPUT_PIN (1 << PA0)
  19:PWM.c         **** 
  20:PWM.c         **** int main(void)
  21:PWM.c         **** {
  16               		.loc 1 21 1 view -0
  17               		.cfi_startproc
  18               	/* prologue: function */
  19               	/* frame size = 0 */
  20               	/* stack size = 0 */

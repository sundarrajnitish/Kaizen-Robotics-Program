   1:ALFR.c        **** /*
   2:ALFR.c        ****  * Project : Advanced Line Following Robot (competition)
   3:ALFR.c        ****  * Level   : Kaizen Robotics Program - Level 1
   4:ALFR.c        ****  * Board   : ATmega16 @ 1 MHz, Embedded C (WinAVR, register level)
   5:ALFR.c        ****  *
   6:ALFR.c        ****  * Line follower that also:
   7:ALFR.c        ****  *   - beeps while crossing perpendicular junctions,
   8:ALFR.c        ****  *   - stops and sounds the buzzer when an obstacle is in front,
   9:ALFR.c        ****  *   - slows down inside a "cave" (detected by a side proximity sensor),
  10:ALFR.c        ****  *     with the speed set by a potentiometer through software PWM.
  11:ALFR.c        ****  *
  12:ALFR.c        ****  *   Line sensors      : 0 over white, 1 over the black line
  13:ALFR.c        ****  *   Proximity sensors : 0 when an object is detected
  14:ALFR.c        ****  *
  15:ALFR.c        ****  * Wiring:
  16:ALFR.c        ****  *   PD0        <- right line sensor     (internal pull-up enabled)
  17:ALFR.c        ****  *   PD1        <- left line sensor      (internal pull-up enabled)
  18:ALFR.c        ****  *   PD2        <- front obstacle sensor (internal pull-up enabled)
  19:ALFR.c        ****  *   PD3        <- cave wall sensor      (internal pull-up enabled)
  20:ALFR.c        ****  *   PA0 (ADC0) <- potentiometer for the cave speed
  21:ALFR.c        ****  *   PB0..PB3   -> L293D motor driver inputs
  22:ALFR.c        ****  *   PB4        -> buzzer
  23:ALFR.c        ****  */
  24:ALFR.c        **** 
  25:ALFR.c        **** #include <avr/io.h>
  26:ALFR.c        **** #include <util/delay.h>
  27:ALFR.c        **** 
  28:ALFR.c        **** #define MOTOR_STOP      0b00000000
  29:ALFR.c        **** #define MOTOR_FORWARD   0b00001010
  30:ALFR.c        **** #define MOTOR_LEFT      0b00000110  // Spin left on the spot
  31:ALFR.c        **** #define MOTOR_RIGHT     0b00001001  // Spin right on the spot
  32:ALFR.c        **** #define BUZZER          0b00010000
  33:ALFR.c        **** 
  34:ALFR.c        **** #define PWM_PERIOD_MS       25      // Total period of one PWM cycle
  35:ALFR.c        **** #define ADC_SCALE           40      // ADC counts per millisecond of OFF time
  36:ALFR.c        **** #define ADC_PWM_THRESHOLD   870     // Above this the cave speed is full speed
  37:ALFR.c        **** 
  38:ALFR.c        **** // PIND patterns with the cave sensor bit (PD3) set, i.e. outside a cave.
  39:ALFR.c        **** // Unused pins PD4..PD7 are pulled up and read as 1.
  40:ALFR.c        **** #define LINE_CENTRED        0b11111100
  41:ALFR.c        **** #define LINE_UNDER_LEFT     0b11111110
  42:ALFR.c        **** #define LINE_UNDER_RIGHT    0b11111101
  43:ALFR.c        **** #define CROSSROAD           0b11111111
  44:ALFR.c        **** #define OBSTACLE_AHEAD      0b11111000
  45:ALFR.c        **** #define NO_CAVE_WALL        (1 << PD3)
  46:ALFR.c        **** 
  47:ALFR.c        **** #define NO_CHANGE           0xFF    // Unknown pattern: keep the last output
  48:ALFR.c        **** 
  49:ALFR.c        **** // _delay_ms() needs a compile-time constant, so wait 1 ms at a time
  50:ALFR.c        **** static void delay_ms(uint16_t ms)
  51:ALFR.c        **** {
  52:ALFR.c        ****     while (ms--)
  53:ALFR.c        ****     {
  54:ALFR.c        ****         _delay_ms(1);
  55:ALFR.c        ****     }
  56:ALFR.c        **** }
  57:ALFR.c        **** 
  58:ALFR.c        **** static void init_adc(void)
  59:ALFR.c        **** {
  60:ALFR.c        ****     ADCSRA |= (1 << ADEN);          // Enable the ADC
  61:ALFR.c        ****     ADCSRA |= (1 << ADPS2);         // Prescaler /16 -> 62.5 kHz ADC clock
  62:ALFR.c        ****     ADMUX  |= (1 << REFS0);         // AVCC as reference, channel ADC0
  63:ALFR.c        **** }
  64:ALFR.c        **** 
  65:ALFR.c        **** static uint16_t read_adc(void)
  66:ALFR.c        **** {
  67:ALFR.c        ****     ADCSRA |= (1 << ADSC);          // Start a conversion
  68:ALFR.c        ****     while ((ADCSRA & (1 << ADIF)) == 0)
  69:ALFR.c        ****     {
  70:ALFR.c        ****         // Wait for the conversion to finish
  71:ALFR.c        ****     }
  72:ALFR.c        ****     ADCSRA |= (1 << ADIF);          // Clear the flag by writing 1 to it
  73:ALFR.c        **** 
  74:ALFR.c        ****     return ADC;                     // 10-bit result, 0..1023
  75:ALFR.c        **** }
  76:ALFR.c        **** 
  77:ALFR.c        **** // Chooses the PORTB output from the line and obstacle sensors (PD0..PD2)
  78:ALFR.c        **** static uint8_t line_decision(uint8_t sensors)
  79:ALFR.c        **** {
  80:ALFR.c        ****     switch (sensors | NO_CAVE_WALL)
  81:ALFR.c        ****     {
  82:ALFR.c        ****         case LINE_CENTRED:     return MOTOR_FORWARD;
  83:ALFR.c        ****         case LINE_UNDER_LEFT:  return MOTOR_LEFT;
  84:ALFR.c        ****         case LINE_UNDER_RIGHT: return MOTOR_RIGHT;
  85:ALFR.c        ****         case CROSSROAD:        return MOTOR_FORWARD | BUZZER;  // Beep and cross
  86:ALFR.c        ****         case OBSTACLE_AHEAD:   return BUZZER;                  // Stop and alarm
  87:ALFR.c        ****         default:               return NO_CHANGE;
  88:ALFR.c        ****     }
  89:ALFR.c        **** }
  90:ALFR.c        **** 
  91:ALFR.c        **** // One software PWM cycle of `output`, duty cycle set by the potentiometer
  92:ALFR.c        **** static void cave_speed_cycle(uint8_t output)
  93:ALFR.c        **** {
  94:ALFR.c        ****     uint16_t reading = read_adc();
  95:ALFR.c        ****     uint16_t t_off   = reading / ADC_SCALE;
  96:ALFR.c        ****     uint16_t t_on    = PWM_PERIOD_MS - t_off;
  97:ALFR.c        **** 
  98:ALFR.c        ****     PORTB = output;
  99:ALFR.c        ****     if (reading <= ADC_PWM_THRESHOLD)
 100:ALFR.c        ****     {
 101:ALFR.c        ****         delay_ms(t_on);
 102:ALFR.c        ****         PORTB = output & BUZZER;    // Motors off, buzzer unchanged
 103:ALFR.c        ****         delay_ms(t_off);
 104:ALFR.c        ****     }
 105:ALFR.c        **** }
 106:ALFR.c        **** 

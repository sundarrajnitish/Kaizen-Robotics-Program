  29               		.loc 1 36 5 is_stmt 1 view .LVU5
  30               		.loc 1 36 11 is_stmt 0 view .LVU6
  31 0006 87BB      		out 0x17,r24
  37:LFR.c         **** 
  38:LFR.c         ****     while (1)
  39:LFR.c         ****     {
  40:LFR.c         ****         switch (PIND)
  41:LFR.c         ****         {
  42:LFR.c         ****             case LINE_CENTRED:
  43:LFR.c         ****                 PORTB = MOTOR_FORWARD;
  44:LFR.c         ****                 break;
  45:LFR.c         **** 
  46:LFR.c         ****             case LINE_UNDER_LEFT:
  47:LFR.c         ****                 PORTB = MOTOR_LEFT;
  32               		.loc 1 47 23 view .LVU7

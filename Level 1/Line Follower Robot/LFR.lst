  51:LFR.c         ****                 PORTB = MOTOR_RIGHT;
  52:LFR.c         ****                 break;
  53:LFR.c         **** 
  54:LFR.c         ****             case CROSSROAD:
  55:LFR.c         ****                 PORTB = MOTOR_FORWARD | BUZZER;     // Beep and cross over

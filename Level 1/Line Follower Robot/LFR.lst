   1:LFR.c         **** /*
   2:LFR.c         ****  * Project : Line Follower Robot
   3:LFR.c         ****  * Level   : Kaizen Robotics Program - Level 1
   4:LFR.c         ****  * Board   : ATmega16 @ 1 MHz, Embedded C (WinAVR, register level)
   5:LFR.c         ****  *
   6:LFR.c         ****  * Follows a black line using two IR sensors that straddle it. Each sensor
   7:LFR.c         ****  * reads 0 over the white surface and 1 over the black line. When both
   8:LFR.c         ****  * sensors see black the robot is on a crossroad: it beeps and drives
   9:LFR.c         ****  * straight across.
  10:LFR.c         ****  *
  11:LFR.c         ****  * Wiring:
  12:LFR.c         ****  *   PD0        <- right IR sensor  (internal pull-up enabled)
  13:LFR.c         ****  *   PD1        <- left IR sensor   (internal pull-up enabled)
  14:LFR.c         ****  *   PB0..PB3   -> L293D motor driver inputs
  15:LFR.c         ****  *   PB4        -> buzzer
  16:LFR.c         ****  */
  17:LFR.c         **** 
  18:LFR.c         **** #include <avr/io.h>
  19:LFR.c         **** #include <util/delay.h>
  20:LFR.c         **** 
  21:LFR.c         **** #define MOTOR_FORWARD   0b00001010
  22:LFR.c         **** #define MOTOR_LEFT      0b00000110  // Spin left on the spot
  23:LFR.c         **** #define MOTOR_RIGHT     0b00001001  // Spin right on the spot
  24:LFR.c         **** #define BUZZER          0b00010000
  25:LFR.c         **** 
  26:LFR.c         **** // PIND patterns (unused pins PD2..PD7 are pulled up and read as 1)
  27:LFR.c         **** #define LINE_CENTRED    0b11111100  // Both sensors on white
  28:LFR.c         **** #define LINE_UNDER_LEFT 0b11111110  // Left sensor on the line
  29:LFR.c         **** #define LINE_UNDER_RIGHT 0b11111101 // Right sensor on the line
  30:LFR.c         **** #define CROSSROAD       0b11111111  // Both sensors on the line
  31:LFR.c         **** 
  32:LFR.c         **** int main(void)
  33:LFR.c         **** {
  16               		.loc 1 33 1 view -0
  17               		.cfi_startproc
  18               	/* prologue: function */
  19               	/* frame size = 0 */

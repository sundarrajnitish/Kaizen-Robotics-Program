  52:WC.c          **** 
  53:WC.c          **** static void uart_init(void)
  54:WC.c          **** {
  55:WC.c          ****     UBRRH = (uint8_t)(UBRR_VALUE >> 8);
  56:WC.c          ****     UBRRL = (uint8_t)UBRR_VALUE;
  57:WC.c          ****     UCSRB |= (1 << RXEN);           // Enable the receiver
  58:WC.c          **** }
  59:WC.c          **** 
  60:WC.c          **** static uint8_t uart_receive(void)
  61:WC.c          **** {
  62:WC.c          ****     while ((UCSRA & (1 << RXC)) == 0)
  63:WC.c          ****     {
  64:WC.c          ****         // Wait until a byte has been received
  65:WC.c          ****     }
  66:WC.c          ****     return UDR;
  67:WC.c          **** }
  68:WC.c          **** 
  69:WC.c          **** static void restart_capture(uint8_t tccr1b)
  70:WC.c          **** {
  71:WC.c          ****     TCNT1  = 0;
  72:WC.c          ****     TCCR1B = tccr1b;
  73:WC.c          ****     TIFR   = (1 << ICF1);           // Clear input capture flag
  74:WC.c          ****     TIFR   = (1 << TOV1);           // Clear overflow flag
  75:WC.c          ****     timer_overflows = 0;
  76:WC.c          **** }
  77:WC.c          **** 
  78:WC.c          **** // Wait for the next input capture edge; returns 0 on timeout
  79:WC.c          **** static uint8_t wait_for_edge(void)
  80:WC.c          **** {
  81:WC.c          ****     while ((TIFR & (1 << ICF1)) == 0)
  82:WC.c          ****     {
  83:WC.c          ****         if (timer_overflows >= ECHO_TIMEOUT_OVERFLOWS)
  84:WC.c          ****         {
  85:WC.c          ****             return 0;
  86:WC.c          ****         }
  87:WC.c          ****     }
  88:WC.c          ****     return 1;
  89:WC.c          **** }
  90:WC.c          **** 
  91:WC.c          **** // Returns the distance to the nearest object in cm, or 0xFFFF if no echo
  92:WC.c          **** static uint16_t measure_distance_cm(void)
  93:WC.c          **** {
  94:WC.c          ****     PORTA |= (1 << TRIGGER_PIN);    // 10 us trigger pulse
  95:WC.c          ****     _delay_us(10);
  96:WC.c          ****     PORTA &= ~(1 << TRIGGER_PIN);
  97:WC.c          **** 
  98:WC.c          ****     restart_capture((1 << ICES1) | (1 << CS10));    // Rising edge, no prescaler
  99:WC.c          ****     if (!wait_for_edge())
 100:WC.c          ****     {
 101:WC.c          ****         return 0xFFFF;
 102:WC.c          ****     }
 103:WC.c          **** 
 104:WC.c          ****     restart_capture(1 << CS10);                     // Falling edge, no prescaler
 105:WC.c          ****     if (!wait_for_edge())
 106:WC.c          ****     {
 107:WC.c          ****         return 0xFFFF;
 108:WC.c          ****     }
 109:WC.c          **** 
 110:WC.c          ****     uint32_t ticks = ICR1 + 65536UL * timer_overflows;
 111:WC.c          ****     return (uint16_t)(ticks / TICKS_PER_CM);
 112:WC.c          **** }

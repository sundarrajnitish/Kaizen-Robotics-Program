   1:WC.c          **** /*
   2:WC.c          ****  * Project : Bluetooth Controlled Wheelchair with Obstacle Avoidance
   3:WC.c          ****  * Level   : Kaizen Robotics Program - Level 1 (final project)
   4:WC.c          ****  * Board   : ATmega16 @ 1 MHz, Embedded C (WinAVR, register level)
   5:WC.c          ****  *
   6:WC.c          ****  * The wheelchair is driven from the Android app "Bluetooth RC Controller"
   7:WC.c          ****  * through an HC-05 module. After every command it measures the distance
   8:WC.c          ****  * ahead with an HC-SR04 ultrasonic sensor; if something is closer than
   9:WC.c          ****  * STOP_DISTANCE_CM it stops for a second and then backs away.
  10:WC.c          ****  *
  11:WC.c          ****  *   'F' forward   'B' backward   'L' left   'R' right   other: stop
  12:WC.c          ****  *
  13:WC.c          ****  * The echo pulse is timed with Timer1 input capture, so the timer runs at
  14:WC.c          ****  * F_CPU (1 tick = 1 us at 1 MHz). Sound covers 1 cm and back in ~58 us.
  15:WC.c          ****  *
  16:WC.c          ****  * Wiring:
  17:WC.c          ****  *   PD0 (RXD)  <- HC-05 TX, 4800 baud 8N1
  18:WC.c          ****  *   PA0        -> HC-SR04 TRIG
  19:WC.c          ****  *   PD6 (ICP1) <- HC-SR04 ECHO
  20:WC.c          ****  *   PB0..PB3   -> L293D motor driver inputs (motors mounted mirrored,
  21:WC.c          ****  *                 so the left/right patterns are swapped vs. the kit robot)
  22:WC.c          ****  */
  23:WC.c          **** 
  24:WC.c          **** #ifndef F_CPU
  25:WC.c          **** #define F_CPU 1000000UL
  26:WC.c          **** #endif
  27:WC.c          **** 
  28:WC.c          **** #include <avr/io.h>
  29:WC.c          **** #include <avr/interrupt.h>
  30:WC.c          **** #include <util/delay.h>
  31:WC.c          **** 
  32:WC.c          **** #define BAUDRATE        4800
  33:WC.c          **** #define UBRR_VALUE      ((F_CPU / (BAUDRATE * 16UL)) - 1)
  34:WC.c          **** 
  35:WC.c          **** #define MOTOR_STOP      0b00000000
  36:WC.c          **** #define MOTOR_FORWARD   0b00001010
  37:WC.c          **** #define MOTOR_BACKWARD  0b00000101
  38:WC.c          **** #define MOTOR_LEFT      0b00001001
  39:WC.c          **** #define MOTOR_RIGHT     0b00000110
  40:WC.c          **** 
  41:WC.c          **** #define TRIGGER_PIN     PA0
  42:WC.c          **** #define TICKS_PER_CM    (58UL * (F_CPU / 1000000UL))
  43:WC.c          **** #define STOP_DISTANCE_CM 40
  44:WC.c          **** #define ECHO_TIMEOUT_OVERFLOWS 2    // ~130 ms at 1 MHz without an echo
  45:WC.c          **** 
  46:WC.c          **** static volatile uint16_t timer_overflows = 0;
  47:WC.c          **** 
  48:WC.c          **** ISR(TIMER1_OVF_vect)

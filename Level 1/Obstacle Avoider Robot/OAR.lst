  22               		.loc 1 52 5 view .LVU1
  23               		.loc 1 52 11 is_stmt 0 view .LVU2
  24 0000 11BA      		out 0x11,__zero_reg__
  53:OAR.c         ****     PORTD = 0b11111111;             // Enable pull-ups on Port D
  25               		.loc 1 53 5 is_stmt 1 view .LVU3
  26               		.loc 1 53 11 is_stmt 0 view .LVU4
  27 0002 8FEF      		ldi r24,lo8(-1)
  28 0004 82BB      		out 0x12,r24
  54:OAR.c         ****     DDRB  = 0b11111111;             // Port B is an output port
  29               		.loc 1 54 5 is_stmt 1 view .LVU5
  30               		.loc 1 54 11 is_stmt 0 view .LVU6
  31 0006 87BB      		out 0x17,r24
  55:OAR.c         **** 
  56:OAR.c         ****     while (1)
  57:OAR.c         ****     {
  58:OAR.c         ****         switch (PIND)
  59:OAR.c         ****         {
  60:OAR.c         ****             case CLEAR:
  61:OAR.c         ****                 PORTB = MOTOR_FORWARD;
  62:OAR.c         ****                 break;
  63:OAR.c         **** 
  64:OAR.c         ****             case OBSTACLE_RIGHT:
  65:OAR.c         ****                 PORTB = MOTOR_LEFT;
  66:OAR.c         ****                 break;
  67:OAR.c         **** 
  68:OAR.c         ****             case OBSTACLE_LEFT:
  69:OAR.c         ****                 PORTB = MOTOR_RIGHT;
  70:OAR.c         ****                 break;
  71:OAR.c         **** 
  72:OAR.c         ****             case OBSTACLE_CENTRE:
  73:OAR.c         ****             case OBSTACLE_CENTRE_RIGHT:
  74:OAR.c         ****             case OBSTACLE_LEFT_RIGHT:
  75:OAR.c         ****                 back_off_and_turn(MOTOR_LEFT);
  76:OAR.c         ****                 break;
  77:OAR.c         **** 
  78:OAR.c         ****             case OBSTACLE_LEFT_CENTRE:
  79:OAR.c         ****             case OBSTACLE_CENTRE_AUX:
  80:OAR.c         ****                 back_off_and_turn(MOTOR_RIGHT);
  81:OAR.c         ****                 break;
  82:OAR.c         **** 
  83:OAR.c         ****             case OBSTACLE_ALL:
  84:OAR.c         ****                 PORTB = MOTOR_RIGHT;        // Boxed in: turn until clear

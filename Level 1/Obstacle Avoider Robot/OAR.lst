   1:OAR.c         **** /*
   2:OAR.c         ****  * Project : Obstacle Avoider Robot
   3:OAR.c         ****  * Level   : Kaizen Robotics Program - Level 1
   4:OAR.c         ****  * Board   : ATmega16 @ 1 MHz, Embedded C (WinAVR, register level)
   5:OAR.c         ****  *
   6:OAR.c         ****  * Drives forward until one of three front IR proximity sensors detects an
   7:OAR.c         ****  * obstacle, then steers or backs away from it. The sensors pull their
   8:OAR.c         ****  * output low when something is in front of them.
   9:OAR.c         ****  *
  10:OAR.c         ****  * Wiring:
  11:OAR.c         ****  *   PD0        <- right IR proximity sensor   (internal pull-up enabled)
  12:OAR.c         ****  *   PD1        <- centre IR proximity sensor  (internal pull-up enabled)
  13:OAR.c         ****  *   PD2        <- left IR proximity sensor    (internal pull-up enabled)
  14:OAR.c         ****  *   PD3        <- auxiliary sensor input      (internal pull-up enabled)
  15:OAR.c         ****  *   PB0..PB3   -> L293D motor driver inputs
  16:OAR.c         ****  */
  17:OAR.c         **** 
  18:OAR.c         **** #include <avr/io.h>
  19:OAR.c         **** #include <util/delay.h>
  20:OAR.c         **** 
  21:OAR.c         **** #define MOTOR_FORWARD   0b00001010
  22:OAR.c         **** #define MOTOR_BACKWARD  0b00000101
  23:OAR.c         **** #define MOTOR_LEFT      0b00000110  // Spin left on the spot
  24:OAR.c         **** #define MOTOR_RIGHT     0b00001001  // Spin right on the spot
  25:OAR.c         **** 
  26:OAR.c         **** #define BACK_OFF_MS     300         // Reverse time before turning away
  27:OAR.c         **** #define TURN_MS         300         // Turn time after reversing
  28:OAR.c         **** #define ESCAPE_TURN_MS  2000        // Turn time when boxed in on all sides
  29:OAR.c         **** 
  30:OAR.c         **** // PIND patterns: a 0 bit means that sensor sees an obstacle
  31:OAR.c         **** #define CLEAR               0b11111111
  32:OAR.c         **** #define OBSTACLE_RIGHT      0b11111110
  33:OAR.c         **** #define OBSTACLE_CENTRE     0b11111101
  34:OAR.c         **** #define OBSTACLE_CENTRE_RIGHT 0b11111100
  35:OAR.c         **** #define OBSTACLE_LEFT       0b11111011
  36:OAR.c         **** #define OBSTACLE_LEFT_RIGHT 0b11111010
  37:OAR.c         **** #define OBSTACLE_LEFT_CENTRE 0b11111001
  38:OAR.c         **** #define OBSTACLE_ALL        0b11111000
  39:OAR.c         **** #define OBSTACLE_CENTRE_AUX 0b11110101
  40:OAR.c         **** 
  41:OAR.c         **** // Reverse away from the obstacle, then turn for TURN_MS
  42:OAR.c         **** static void back_off_and_turn(uint8_t turn)
  43:OAR.c         **** {
  44:OAR.c         ****     PORTB = MOTOR_BACKWARD;
  45:OAR.c         ****     _delay_ms(BACK_OFF_MS);
  46:OAR.c         ****     PORTB = turn;
  47:OAR.c         ****     _delay_ms(TURN_MS);
  48:OAR.c         **** }
  49:OAR.c         **** 
  50:OAR.c         **** int main(void)
  51:OAR.c         **** {
  16               		.loc 1 51 1 view -0
  17               		.cfi_startproc
